rules_version = '2';

// Deny-all. Every read in the dashboard goes through the Admin SDK server-side
// (lib/firebase/admin-db.ts), and every write through the Python aisa-api, which
// bypasses rules entirely — so the browser has no legitimate reason to touch
// Firestore directly, and any request that reaches these rules is either a
// mistake or an attack.
//
// This is the security boundary of LAST resort: the real gate is `runAction` /
// `runFormAction` + `requireCapability`. Do not relax these rules to "make the
// client work" — if a client needs data, add a server entry point.
//
// If a future feature genuinely needs direct client access (e.g. realtime
// listeners), carve out that ONE collection with an explicit, tested rule and
// leave the default deny in place.

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
