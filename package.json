{
  "name": "aisa",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "firebase emulators:exec --ui --project demo-aisa --import=./.emulator-data --export-on-exit=./.emulator-data \"pnpm setup:local && pnpm dev:next\"",
    "dev:next": "next dev",
    "build": "next build",
    "start": "next start",
    "emulators": "firebase emulators:start --project demo-aisa",
    "setup:local": "node scripts/setup-local.ts",
    "seed": "node scripts/seed-emulator.ts",
    "db:reset": "node scripts/db-reset.ts",
    "migrate": "node scripts/migration/run.ts",
    "snapshot:export": "node scripts/snapshot/export.ts",
    "snapshot:restore": "node scripts/snapshot/restore.ts",
    "node:check": "node scripts/check-node-version.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:rules": "ast-grep scan && ast-grep test --skip-snapshot-tests",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "templates:check": "node scripts/check-templates.ts",
    "structure:check": "node scripts/structure/check.ts",
    "docs:check": "node scripts/docs/check.ts",
    "docs:generate": "node scripts/docs/generate-reference.ts",
    "indexes:check": "node scripts/check-indexes.ts",
    "test": "vitest run --no-file-parallelism",
    "test:unit": "vitest run --exclude '**/test/integration/**' --exclude '**/firestore.rules.test.ts'",
    "test:integration": "firebase emulators:exec --project demo-aisa --only auth,firestore \"pnpm vitest run --no-file-parallelism test/integration firestore.rules.test.ts && pnpm indexes:check\"",
    "test:watch": "vitest --exclude '**/test/integration/**' --exclude '**/firestore.rules.test.ts'",
    "test:emulator": "firebase emulators:exec --project demo-aisa --only auth,firestore \"pnpm test && pnpm indexes:check\"",
    "build:ci": "node scripts/build-ci.ts",
    "image:check": "node scripts/check-image-digest.ts",
    "smoke:image": "node scripts/smoke-image.ts",
    "test:e2e": "playwright test",
    "test:e2e:container": "node scripts/e2e-container.ts",
    "test:e2e:ci": "pnpm test:e2e:fast",
    "test:e2e:fast": "node scripts/e2e-fast.ts",
    "check:static": "pnpm node:check && pnpm typecheck && pnpm templates:check && pnpm lint && pnpm lint:rules && pnpm format:check && pnpm docs:check && pnpm structure:check",
    "verify": "pnpm check:static && pnpm test:unit && pnpm test:integration && pnpm build:ci && echo \"verify: static + unit + integration + build passed. DRIVEN steps are NOT covered here — run them per docs how-to and the verify skill: emulator sign-in, browser acceptance matrix, env fail-fast, production container smoke, and E2E.\"",
    "ci:local": "node scripts/ci-local.ts",
    "prepare": "node scripts/install-hooks.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@sentry/nextjs": "^10.66.0",
    "@tanstack/react-form": "^1.33.2",
    "@tanstack/react-form-nextjs": "^1.33.2",
    "@tanstack/react-pacer": "^0.22.1",
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "firebase": "^12.16.0",
    "firebase-admin": "^14.2.0",
    "lucide-react": "^1.25.0",
    "next": "^16.2.11",
    "next-themes": "^0.4.6",
    "nuqs": "^2.9.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-number-format": "^5.4.5",
    "shadcn": "^4.13.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.44.1",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@kie/act-js": "2.6.2",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "firebase-tools": "^15.24.0",
    "jsdom": "^29.1.1",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "24.18.0"
  },
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72"
}
