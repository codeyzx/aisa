# Compose-only runtime overrides for the LOCAL stack.
#
# This file is loaded AFTER `.env` (see compose.yaml's `env_file:`), so every
# value here WINS. That is deliberate and it is the only reason the stack works:
# `.env` is written for a process running on the HOST, and several of its values
# are wrong once the same app runs inside a container.
#
# Two spellings, and the difference between them matters:
#
#   - A bare value is a container-only truth that MUST override `.env`.
#     `seaweedfs` and `host.docker.internal` are names that resolve only from
#     inside the compose network; on the host they mean nothing.
#   - A `${VAR:-default}` value is a DEFAULT, not an override. Compose
#     interpolates it before the container starts, reading the project's `.env`,
#     so a value the developer set there flows straight through and only a value
#     they never set falls back.
#
# Nothing secret belongs here: this file is tracked, and the local S3 identity it
# names is the one already committed in `seaweedfs.s3.json`.

# The storage backend is a sibling container, reachable by service name over the
# compose network. The host publishes 127.0.0.1:8333 for a host-side `pnpm dev`,
# and that address is unreachable from inside the app container.
S3_ENDPOINT=http://seaweedfs:8333
# …and THAT is the address the app uses, not the one the browser can use. A
# presigned URL is signed against a host, so whichever endpoint mints it is baked
# in — handing the browser a `seaweedfs:8333` URL means handing it a name that
# resolves only on the compose network, and every upload fails to connect. This
# is the address the READER's browser reaches, published by the `seaweedfs`
# service below; override S3_HOST_PORT (not this line) if 8333 is taken.
S3_PUBLIC_ENDPOINT=http://127.0.0.1:${S3_HOST_PORT:-8333}
S3_REGION=${S3_REGION:-us-east-1}
S3_BUCKET=${S3_BUCKET:-aisa-dev}
S3_ACCESS_KEY_ID=${S3_ACCESS_KEY_ID:-aisa-dev-key}
S3_SECRET_ACCESS_KEY=${S3_SECRET_ACCESS_KEY:-aisa-dev-secret}

# The Firebase emulator suite runs on the HOST (`pnpm emulators`), on purpose, so
# `pnpm dev` and this stack share one seeded database. `.env` names it
# `127.0.0.1`, which inside a container is the container itself — so these two
# lines are the difference between a working stack and one that comes up healthy
# and then fails every Firestore call. That failure is quiet in the worst way:
# `isEmulatorTarget()` still reads true, so the boot check treats the Admin
# credential as unnecessary and nothing complains until the first query.
# `host.docker.internal` is mapped to the host gateway in compose.yaml; the ports
# are the emulator defaults from firebase.json.
FIRESTORE_EMULATOR_HOST=host.docker.internal:8080
FIREBASE_AUTH_EMULATOR_HOST=host.docker.internal:9099

# The AI capability is off by default (`AI_ENABLED` unset), so this is never read.
# It exists so that turning AI on in `.env` does not also mean remembering a key
# here — a real one belongs in `.env` and wins by interpolation.
ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY:-local-placeholder-not-a-real-key}
